    "test": "jest --passWithNoTests --forceExit --ci --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@watsapp/database": "workspace:*",
    "@watsapp/shared": "workspace:*",
    "axios": "1.20.0",
    "bullmq": "6.3.15",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3"
  }
