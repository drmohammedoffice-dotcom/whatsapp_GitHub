/// Chatloora platform official WhatsApp sender (Admin-only). Never belongs to a customer Team.
enum OfficialWhatsAppSenderStatus {
  DISCONNECTED
  CONNECTED
  DISABLED
  FAILED
}

enum OfficialNotificationType {
  ACCOUNT_VERIFICATION_OTP
  LOGIN_OTP
  PASSWORD_RESET_OTP
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRING_SOON
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCESSFUL
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWAL
  SYSTEM_NOTIFICATION
}

enum OfficialNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model OfficialWhatsAppSender {
  id                    String                       @id @default("chatloora-official")
  wabaId                String                       @default("") @map("waba_id")
  phoneNumberId         String                       @default("") @map("phone_number_id")
  displayPhoneNumber    String                       @default("") @map("display_phone_number")
  displayName           String                       @default("") @map("display_name")
  encryptedAccessToken  String                       @default("") @map("encrypted_access_token")
  status                OfficialWhatsAppSenderStatus @default(DISCONNECTED)
  enabled               Boolean                      @default(false)
  webhookStatus         String                       @default("unknown") @map("webhook_status")
  lastTestedAt          DateTime?                    @map("last_tested_at")
  lastError             String?                      @map("last_error")
  metadata              Json?
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  @@map("official_whatsapp_senders")
}

model OfficialWhatsAppTemplate {
  id        String                   @id @default(cuid())
  type      OfficialNotificationType @unique
  name      String
  language  String                   @default("en")
  enabled   Boolean                  @default(false)
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  @@map("official_whatsapp_templates")
}

model OfficialWhatsAppOtpConfig {
  id                      String   @id @default("otp")
  enabled                 Boolean  @default(false)
  loginEnabled            Boolean  @default(false) @map("login_enabled")
  passwordResetEnabled    Boolean  @default(false) @map("password_reset_enabled")
  templateName            String   @default("") @map("template_name")
  language                String   @default("en")
  expirySeconds           Int      @default(600) @map("expiry_seconds")
  resendCooldownSeconds   Int      @default(60) @map("resend_cooldown_seconds")
  maxAttempts             Int      @default(5) @map("max_attempts")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("official_whatsapp_otp_config")
}

model OfficialSubscriptionNotifyConfig {
  id                 String   @id @default("subscription")
  enabled            Boolean  @default(false)
  reminder1Days      Int      @default(7) @map("reminder1_days")
  reminder1Enabled   Boolean  @default(true) @map("reminder1_enabled")
  reminder2Days      Int      @default(1) @map("reminder2_days")
  reminder2Enabled   Boolean  @default(true) @map("reminder2_enabled")
  expiredEnabled     Boolean  @default(true) @map("expired_enabled")
  paymentEnabled     Boolean  @default(false) @map("payment_enabled")
  activatedEnabled   Boolean  @default(false) @map("activated_enabled")
  renewalEnabled     Boolean  @default(false) @map("renewal_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("official_subscription_notify_config")
}

model SubscriptionNotificationLog {
  id                 String                     @id @default(cuid())
  userId             String?                    @map("user_id")
  subscriptionId     String                     @map("subscription_id")
  teamId             String?                    @map("team_id")
  notificationType   OfficialNotificationType   @map("notification_type")
  templateName       String                     @map("template_name")
  status             OfficialNotificationStatus @default(PENDING)
  providerMessageId  String?                    @map("provider_message_id")
  /// Calendar date used for reminder idempotency (one send per event/day).
  scheduledDate      DateTime                   @map("scheduled_date") @db.Date
  phone              String?
  sentAt             DateTime?                  @map("sent_at")
  failureReason      String?                    @map("failure_reason")
  attempts           Int                        @default(0)
  createdAt          DateTime                   @default(now()) @map("created_at")
  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, notificationType, scheduledDate])
  @@index([status, createdAt])
  @@index([userId])
  @@map("subscription_notification_logs")
}

model PhoneOtpVerification {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  phone       String
  email       String?
  purpose     String
  otpHash     String    @map("otp_hash")
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  verifiedAt  DateTime? @map("verified_at")
  lastSentAt  DateTime  @default(now()) @map("last_sent_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([email, purpose])
  @@map("phone_otp_verifications")
}

/// صناديق بريد @chatloora.com — الدخول عبر /mail؛ الإرسال/الاستقبال عبر Resend.
model DomainMailbox {
  id                 String                 @id @default(cuid())
  localPart          String                 @map("local_part")
  email              String                 @unique
  displayName        String?                @map("display_name")
  passwordHash       String                 @map("password_hash")
  passwordEncrypted  String                 @map("password_encrypted")
  isActive           Boolean                @default(true) @map("is_active")
  notes              String?
  lastLoginAt        DateTime?              @map("last_login_at")
  createdByAdminId   String?                @map("created_by_admin_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  messages           DomainMailboxMessage[]

  @@unique([localPart])
  @@index([isActive])
  @@map("domain_mailboxes")
}

model DomainMailboxMessage {
  id              String         @id @default(cuid())
  mailboxId       String         @map("mailbox_id")
  folder          String         @default("INBOX")
  direction       String
  resendEmailId   String?        @map("resend_email_id")
  messageIdHeader String?        @map("message_id_header")
  fromAddress     String         @map("from_address")
  toAddresses     String         @map("to_addresses")
  ccAddresses     String?        @map("cc_addresses")
  bccAddresses    String?        @map("bcc_addresses")
  subject         String         @default("")
  textBody        String?        @map("text_body") @db.Text
  htmlBody        String?        @map("html_body") @db.Text
  preview         String         @default("")
  seen            Boolean        @default(false)
  flagged         Boolean        @default(false)
  hasAttachments  Boolean        @default(false) @map("has_attachments")
  attachmentsJson Json?          @map("attachments_json")
  sentAt          DateTime?      @map("sent_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  mailbox         DomainMailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, resendEmailId])
  @@index([mailboxId, folder, createdAt])
  @@index([mailboxId, seen])
  @@map("domain_mailbox_messages")
}



