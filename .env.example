NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watsapp?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=change-me-32-byte-minimum-session-key
API_KEY_PEPPER=change-me-api-key-pepper-at-least-32-characters
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret-at-least-32-characters
LOCAL_STORAGE_ROOT=./storage
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace-with-openai-compatible-key
# Platform AI Gateway HA keys (any count). Prefer these over a single AI_API_KEY.
# Never commit real secrets — set them only on the server.
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=
AI_API_KEY_4=
AI_API_KEY_5=
AI_API_KEY_6=
AI_API_KEY_7=
AI_API_KEY_8=
AI_API_KEY_9=
AI_API_KEY_10=
# Alternative: JSON array or comma-separated OpenRouter keys (used when AI_API_KEY_N unset)
# OPENROUTER_KEYS=["sk-or-v1-...","sk-or-v1-..."]
# Optional weights for weighted_round_robin: AI_API_KEY_WEIGHT_1=3
AI_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_CHAT_MODEL=openai/gpt-4o-mini
# Load balancing: least_used | round_robin | weighted_round_robin
AI_GATEWAY_STRATEGY=least_used
AI_GATEWAY_COOLDOWN_MS=300000
AI_GATEWAY_COOLDOWN_MAX_MS=2400000
AI_GATEWAY_CIRCUIT_FAILURES=1
AI_GATEWAY_MAX_RETRIES=3
AI_GATEWAY_HEALTH_INTERVAL_MS=60000
AI_GATEWAY_TIMEOUT_MS=60000
AI_GATEWAY_RPM=60
AI_GATEWAY_RPH=3000
AI_GATEWAY_RPD=50000
AI_GATEWAY_QUEUE_WAIT_MS=30000
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_AUDIO_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_MONTHLY_BUDGET_CENTS=10000
AI_RATE_LIMIT_PER_MINUTE=60

# Google Calendar (AI Appointment System) — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/integrations/google/callback

# Email OTP (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ChatLoora <noreply@almutamayiziq.com>
# Set to false until Resend domain is verified
AUTH_OTP_ENABLED=true

# TikTok Business API (https://business-api.tiktok.com/portal/docs)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Login Kit callback (register this exact URL in TikTok Developer Portal)
TIKTOK_REDIRECT_URI=https://yourdomain.com/api/auth/tiktok/callback
# TikTok Marketing API (numeric App ID — separate from Login Kit client_key)
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TIKTOK_BUSINESS_REDIRECT_URI=https://yourdomain.com/api/auth/tiktok-business/callback
# Chatloora SaaS ads pixel (CompleteRegistration / Purchase after signup & payment)
TIKTOK_PLATFORM_PIXEL_CODE=
TIKTOK_PLATFORM_EVENTS_ACCESS_TOKEN=

# Meta Messenger + Instagram Graph API
META_APP_ID=
META_APP_SECRET=
# Optional — browser SDK (falls back to GET /api/meta/sdk-config)
NEXT_PUBLIC_META_APP_ID=
META_VERIFY_TOKEN=chatloora_secure_verify_token_2026
META_AUTH_REDIRECT_URI=https://yourdomain.com/api/auth/meta/callback
# Legacy redirect (optional): https://yourdomain.com/api/v1/meta/oauth/callback
META_OAUTH_REDIRECT_URI=
# After Meta App Review approves comment scopes, set to true:
META_OAUTH_INCLUDE_COMMENT_SCOPES=false
META_OAUTH_EXTRA_SCOPES=
# WhatsApp Cloud API (Meta App Review / TSP demo)
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_DISPLAY_PHONE=
META_WA_ACCESS_TOKEN=
# WhatsApp Embedded Signup (customer dashboard Connect WhatsApp button)
META_WA_EMBEDDED_CONFIG_ID=2804512506595427
# Instagram API with Instagram Login (separate Meta app — e.g. chatloora-IG)
INSTAGRAM_API_APP_ID=3474464532741582
INSTAGRAM_API_APP_SECRET=

# Telegram personal account (MTProto) — create at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Wayl Payment Gateway (https://wayl.io) — Iraqi Dinar (IQD) payments
# Get your API key from the Wayl merchant dashboard
WAYL_API_KEY=
WAYL_API_BASE_URL=https://api.thewayl.com
# Secret used to verify webhook signatures (10-255 characters)
WAYL_WEBHOOK_SECRET=change-me-wayl-webhook-secret
# live or test
WAYL_ENV=test
