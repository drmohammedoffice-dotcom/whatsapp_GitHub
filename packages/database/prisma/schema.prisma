  adAccountLabel   String?                @map("ad_account_label")
  ipAddress        String?                @map("ip_address")
  userAgent        String?                @map("user_agent")
  deviceType       String?                @map("device_type")
  browser          String?                @map("browser")
  utmSource        String?                @map("utm_source")
  utmMedium        String?                @map("utm_medium")
  utmCampaign      String?                @map("utm_campaign")
  utmContent       String?                @map("utm_content")
  utmTerm          String?                @map("utm_term")
  ttclid           String?
  fbclid           String?
  gclid            String?
  submittedAt      DateTime               @default(now()) @map("submitted_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  team             Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  form             InstantForm            @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([teamId, orderNumber])
  @@index([teamId, submittedAt])
  @@index([formId, submittedAt])
  @@index([teamId, status, submittedAt])
  @@index([customerPhone])
  @@map("instant_form_orders")
}

