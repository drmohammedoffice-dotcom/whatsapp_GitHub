model AdminUser {
  id             String          @id @default(cuid())
  userId         String          @unique @map("user_id")
  /// الدور الأساسي (للتوافق مع النظام القديم)
  role           AdminRole       @default(SUPPORT_AGENT)
  /// أدوار إضافية للموظفين — يمكن الجمع بين محاسب + إنشاء حسابات إلخ
  roles          Json            @default("[]") @map("roles")
  residence      String?         @map("residence")
  /// صورة الملف الشخصي للموظف (مفتاح التخزين المحلي)
  avatarKey      String?         @map("avatar_key")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
