generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum Permission {
  INBOX_READ
  INBOX_WRITE
  CONVERSATION_ASSIGN
  CONVERSATION_CLOSE
  CONTACT_READ
  CONTACT_WRITE
  AGENT_MANAGE
  DEPARTMENT_MANAGE
  ANALYTICS_READ
  SETTINGS_MANAGE
  API_KEY_MANAGE
  WEBHOOK_MANAGE
  AI_ACCESS
  AI_MANAGE_KNOWLEDGE
  AI_MANAGE_TOOLS
  AI_VIEW_COSTS
  TIKTOK_VIEW
  TIKTOK_MANAGE
  BUSINESS_MANAGE
  CAMPAIGN_MANAGE
  WHATSAPP_CLOUD_MANAGE
  ROUTING_MANAGE
}

enum WhatsAppSessionStatus {
  PENDING_QR
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
}

enum WhatsAppConnectionLogEvent {
  QR_GENERATED
  QR_UPDATED
  CONNECTING
  CONNECTED
  DISCONNECTED
  RECONNECTING
  SESSION_RESTORED
  LOGGED_OUT
  FAILED
  MESSAGE_RECEIVED
  PRESENCE_UPDATED
  CONTACTS_UPDATED
}

enum ChannelProvider {
  WHATSAPP_BAILEYS
  WHATSAPP_CLOUD
  META_MESSENGER
  META_INSTAGRAM
  TELEGRAM
  TELEGRAM_USER
}

enum CampaignSourceType {
  TIKTOK
  FACEBOOK
  INSTAGRAM
  GOOGLE
  LANDING_PAGE
  SNAPCHAT
  CUSTOM
}

enum WhatsAppRoutingStrategy {
  MANUAL
  ROUND_ROBIN
  RANDOM
  PERCENTAGE
  COUNTRY
  CAMPAIGN
  AI
}

enum WhatsAppCloudAccountStatus {
  PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
  EXPIRED
}

enum WebhookProvider {
  TIKTOK
  META
  WHATSAPP_CLOUD
  GOOGLE
  CUSTOM
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum TelegramConnectionStatus {
  PENDING_CODE
  PENDING_PASSWORD
  CONNECTING
  CONNECTED
  DISCONNECTED
  EXPIRED
  FAILED
}

enum ChannelStatus {
  PENDING
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
  EXPIRED
}

enum OAuthSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  STICKER
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationEventType {
  CREATED
  MESSAGE_CREATED
  MESSAGE_STATUS_UPDATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  ARCHIVED
  UNARCHIVED
  PINNED
  UNPINNED
  TAGGED
  UNTAGGED
  NOTE_CREATED
  COMMENT_CREATED
  CONTACT_UPDATED
  AI_REPLY_SENT
  AI_TRANSFERRED
  AI_PAUSED
  AI_REACTIVATED
  AUTOMATION_EXECUTED
}

enum AgentPresence {
  OFFLINE
  AVAILABLE
  BUSY
  AWAY
}

enum NotificationType {
  ASSIGNMENT
  MESSAGE
  MENTION
  SYSTEM
  SLA
}

enum WebhookEvent {
  INCOMING_MESSAGE
  DELIVERY_STATUS
  READ_STATUS
  TYPING
  PRESENCE
  CONVERSATION_CREATED
  CONVERSATION_UPDATED
  CONVERSATION_ASSIGNED
  CONVERSATION_MESSAGE_CREATED
  CONTACT_UPDATED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum AiDocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AiMemoryScope {
  CONVERSATION
  CUSTOMER
  BUSINESS
  LONG_TERM
}

enum AiToolKind {
  HTTP_REQUEST
  CRM
  CALENDAR
  EMAIL
  CUSTOM_API
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiAgentType {
  SUPERVISOR
  SALES
  SUPPORT
  MARKETING
  ADMIN
}

enum ConversationAiMode {
  AI_ACTIVE
  AI_PAUSED
  HUMAN_ONLY
}

enum AiTransferReason {
  CUSTOMER_REQUEST
  LOW_CONFIDENCE
  COMPLAINT
  REFUND_REQUEST
  SENSITIVE_ISSUE
  CUSTOM_RULE
  KNOWLEDGE_GAP
}

enum AiProviderType {
  OPENAI_COMPATIBLE
  OPENROUTER
  GROQ
  GEMINI
  CUSTOM
}

enum AutomationTriggerType {
  CONVERSATION_OPENED
  MESSAGE_RECEIVED
  INACTIVITY
  BUSINESS_HOURS
  OUT_OF_OFFICE
  ABANDONED_CART
  FOLLOW_UP
}

enum AutomationActionType {
  SEND_GREETING
  SEND_MESSAGE
  SEND_FOLLOW_UP
  SEND_REMINDER
  AUTO_TAG
  AUTO_ASSIGN
  TRANSFER_TO_HUMAN
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  LOST
}

enum SatisfactionSource {
  AI_CONVERSATION
  HUMAN_CONVERSATION
  SURVEY
}

enum EmailVerificationType {
  SIGNUP
  LOGIN
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  name                String
  passwordHash        String
  emailVerifiedAt     DateTime?
  suspendedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  teamMembers         TeamMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerification[]
  auditLogs           AuditLog[]
  assignedConversations Conversation[]         @relation("ConversationAssignee")
  authoredNotes       ConversationNote[]
  authoredComments    InternalComment[]
  notifications       Notification[]
  agentStatuses       AgentStatus[]
  aiMemories          AiMemory[]
  aiRuns              AiRun[]
  createdWhatsAppSessions WhatsAppSession[] @relation("WhatsAppSessionCreator")
  initiatedTransfers ConversationTransfer[] @relation("TransferInitiator")
  assignedTransfers  ConversationTransfer[] @relation("TransferAssignee")
  tikTokLoginAccount TikTokLoginAccount?
  tikTokMarketingConnection TikTokMarketingConnection?
  tikTokIntegrations TikTokIntegration[]
  adminProfile AdminUser?
  ownedSubscriptions Subscription[]
  platformActivityLogs PlatformActivityLog[]
  platformNotifications PlatformNotification[]
  supportTickets SupportTicket[]
}
model Team {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     TeamMember[]
  sessions    WhatsAppSession[]
  chats       Chat[]
  messages    Message[]
  apiKeys     ApiKey[]
  webhooks    WebhookEndpoint[]
  settings    Setting[]
  auditLogs   AuditLog[]
  channels    Channel[]
  oauthSessions SocialOAuthSession[]
  telegramConnections TelegramConnection[]
  contacts    Contact[]
  identities  ContactIdentity[]
  labels      Label[]
  customFields ContactCustomField[]
  conversations Conversation[]
  conversationMessages ConversationMessage[]
  departments Department[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  analyticsDailyMetrics AnalyticsDailyMetric[]
  aiAgents AiAgent[]
  aiKnowledgeSources AiKnowledgeSource[]
  aiKnowledgeDocuments AiKnowledgeDocument[]
  aiKnowledgeChunks AiKnowledgeChunk[]
  aiMemories AiMemory[]
  aiTools AiTool[]
  aiRuns AiRun[]
  aiCostEvents AiCostEvent[]
  aiSettings AiSettings[]
  aiProviderConfig AiProviderConfig?
  products Product[]
  automationRules AutomationRule[]
  conversationTransfers ConversationTransfer[]
  leads Lead[]
  customerSatisfactions CustomerSatisfaction[]
  bookings Booking[]
  aiTrainingMedia AiTrainingMedia[]
  tikTokAccount TikTokAccount?
  tikTokSettings TikTokSettings?
  tikTokEvents TikTokEvent[]
  tikTokLogs TikTokLog[]
  tikTokTrackingClicks TikTokTrackingClick[]
  tikTokCampaigns TikTokCampaign[]
  tikTokIntegrations TikTokIntegration[]
  tikTokAppCredentials TikTokAppCredentials?
  businesses      Business[]
  platformCampaigns Campaign[]
  trafficSources  TrafficSource[]
  whatsAppCloudAccounts WhatsAppCloudAccount[]
  whatsAppRoutingRules WhatsAppRoutingRule[]
  redirectLogs    RedirectLog[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  metaConnections MetaConnection[]
  subscriptions Subscription[]
  supportTickets SupportTicket[]
  tikTokEventSets TikTokEventSet[]
}
model TeamMember {
  id          String       @id @default(cuid())
  teamId      String
  userId      String
  role        TeamRole     @default(MEMBER)
  permissions Permission[] @default([])
  createdAt   DateTime     @default(now())
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentMemberships DepartmentMember[]

  @@unique([teamId, userId])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  replacedById String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String                @id @default(cuid())
  userId    String?               @map("user_id")
  email     String
  codeHash  String                @map("code")
  type      EmailVerificationType
  expiresAt DateTime              @map("expires_at")
  used      Boolean               @default(false)
  attempts  Int                   @default(0)
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at")
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([userId])
  @@map("email_verifications")
}

model Channel {
  id                     String          @id @default(cuid())
  teamId                 String
  businessId             String?
  provider               ChannelProvider
  name                   String
  status                 ChannelStatus   @default(PENDING)
  externalId             String?
  aiAgentId              String?
  whatsAppSessionId      String?         @unique
  whatsAppCloudAccountId String?         @unique
  telegramConnectionId   String?         @unique
  lastSeenAt             DateTime?
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  team                   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  business               Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  aiAgent                AiAgent?        @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)
  whatsAppSession        WhatsAppSession? @relation(fields: [whatsAppSessionId], references: [id], onDelete: SetNull)
  whatsAppCloudAccount   WhatsAppCloudAccount? @relation(fields: [whatsAppCloudAccountId], references: [id], onDelete: SetNull)
  telegramConnection     TelegramConnection? @relation(fields: [telegramConnectionId], references: [id], onDelete: SetNull)
  metaConnection         MetaConnection?
  identities             ContactIdentity[]
  conversations          Conversation[]
  token                  ChannelToken?

  @@unique([teamId, provider, externalId])
  @@index([teamId, status])
  @@index([teamId, businessId])
  @@index([aiAgentId])
}

model ChannelToken {
  id                    String    @id @default(cuid())
  channelId             String    @unique
  encryptedAccessToken  String
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scopes                String?
  lastRefreshedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  channel               Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model SocialOAuthSession {
  id                String             @id @default(cuid())
  teamId            String
  userId            String
  provider          String
  status            OAuthSessionStatus @default(PENDING)
  encryptedPayload  String
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, provider, status])
  @@index([expiresAt])
}

model TelegramConnection {
  id                String                  @id @default(cuid())
  teamId            String
  connectedByUserId String
  phoneNumber       String
  telegramUserId    String?
  firstName         String?
  lastName          String?
  username          String?
  profilePhotoUrl   String?
  encryptedSession  String?
  status            TelegramConnectionStatus @default(PENDING_CODE)
  connectedAt       DateTime?
  lastSyncAt        DateTime?
  lastSeenAt        DateTime?
  failureReason     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  team              Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channel           Channel?

  @@unique([teamId, phoneNumber])
  @@index([teamId, status])
}

model TelegramAuthPending {
  id                   String   @id @default(cuid())
  teamId               String
  userId               String
  phoneNumber          String
  encryptedTempSession String
  phoneCodeHash        String
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([teamId, userId])
  @@index([expiresAt])
}

model WhatsAppSession {
  id                 String                @id @default(cuid())
  teamId             String
  createdByUserId    String?
  displayName        String?
  phoneNumber        String?
  jid                String?
  profilePhotoUrl    String?
  status             WhatsAppSessionStatus @default(PENDING_QR)
  qrCode             String?
  qrCodeUpdatedAt    DateTime?
  connectedAt        DateTime?
  disconnectedAt     DateTime?
  lastHeartbeatAt    DateTime?
  lastSeenAt         DateTime?
  failureReason      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  team               Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy          User?                 @relation("WhatsAppSessionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  channel            Channel?
  credentials        SessionCredential[]
  chats              Chat[]
  messages           Message[]
  connectionLogs     WhatsAppConnectionLog[]
  whatsAppContacts   WhatsAppContact[]
  campaigns          Campaign[]

  @@index([teamId, status])
  @@index([teamId, createdByUserId])
  @@unique([teamId, phoneNumber])
}

model WhatsAppConnectionLog {
  id        String                    @id @default(cuid())
  teamId    String
  sessionId String
  event     WhatsAppConnectionLogEvent
  message   String?
  metadata  Json?
  createdAt DateTime                  @default(now())
  session   WhatsAppSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([teamId, createdAt])
}

model WhatsAppContact {
  id                String          @id @default(cuid())
  teamId            String
  sessionId         String
  providerContactId String
  displayName       String?
  phoneNumber       String?
  profilePhotoUrl   String?
  isBlocked         Boolean         @default(false)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  session           WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, providerContactId])
  @@index([teamId, sessionId])
}

model SessionCredential {
  id        String          @id @default(cuid())
  sessionId String
  key       String
  value     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, key])
}

model Contact {
  id          String     @id @default(cuid())
  teamId      String
  displayName String
  email       String?
  phone       String?
  avatarUrl   String?
  notes       String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  identities  ContactIdentity[]
  labels      ContactLabel[]
  customValues ContactCustomFieldValue[]
  conversations Conversation[]
  leads         Lead[]
  satisfactions CustomerSatisfaction[]
  bookings      Booking[]
  tikTokEvents  TikTokEvent[]
  tikTokClicks  TikTokTrackingClick[]

  @@index([teamId, displayName])
  @@index([teamId, phone])
  @@index([teamId, email])
}

model ContactIdentity {
  id          String          @id @default(cuid())
  teamId      String
  contactId   String
  channelId   String
  externalId  String
  displayName String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channelId, externalId])
  @@index([teamId, contactId])
}

model ContactCustomField {
  id        String   @id @default(cuid())
  teamId    String
  key       String
  label     String
  type      String
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  values    ContactCustomFieldValue[]

  @@unique([teamId, key])
}

model ContactCustomFieldValue {
  id        String             @id @default(cuid())
  contactId String
  fieldId   String
  value     Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  contact   Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field     ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, fieldId])
}

model Label {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts  ContactLabel[]
  conversations ConversationTag[]

  @@unique([teamId, name])
}

model ContactLabel {
  contactId String
  labelId   String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
}

model Department {
  id          String   @id @default(cuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members     DepartmentMember[]
  conversations Conversation[]

  @@unique([teamId, name])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  teamMemberId String
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, teamMemberId])
}

model AgentStatus {
  id        String        @id @default(cuid())
  userId    String
  teamId    String
  presence  AgentPresence @default(OFFLINE)
  capacity  Int           @default(10)
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId, presence])
}

model Conversation {
  id              String               @id @default(cuid())
  teamId          String
  channelId       String
  contactId       String
  identityId      String?
  departmentId    String?
  assigneeUserId  String?
  subject         String?
  status          ConversationStatus   @default(OPEN)
  priority        ConversationPriority @default(NORMAL)
  isArchived      Boolean              @default(false)
  isPinned        Boolean              @default(false)
  unreadCount     Int                  @default(0)
  firstOpenedAt   DateTime             @default(now())
  lastMessageAt   DateTime?
  lastReadAt      DateTime?
  closedAt        DateTime?
  aiMode          ConversationAiMode @default(AI_ACTIVE)
  aiPausedAt      DateTime?
  aiPausedByUserId String?
  lastAiReplyAt   DateTime?
  greetingSentAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  channel         Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact         Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  identity        ContactIdentity?     @relation(fields: [identityId], references: [id], onDelete: SetNull)
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee        User?                @relation("ConversationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]
  notes           ConversationNote[]
  comments        InternalComment[]
  tags            ConversationTag[]
  events          ConversationEvent[]
  transfers       ConversationTransfer[]
  leads           Lead[]
  satisfactions   CustomerSatisfaction[]
  bookings        Booking[]
  tikTokEvents    TikTokEvent[]
  tikTokClicks    TikTokTrackingClick[]

  @@index([teamId, status, isArchived, lastMessageAt])
  @@index([teamId, assigneeUserId, status])
  @@index([teamId, aiMode])
  @@index([contactId])
}

model ConversationMessage {
  id                String           @id @default(cuid())
  teamId            String
  conversationId    String
  sourceMessageId   String?          @unique
  providerMessageId String?
  direction         MessageDirection
  type              MessageType
  status            MessageStatus    @default(PENDING)
  text              String?
  payload           Json?
  mediaStorageKey   String?
  mediaMimeType     String?
  mediaFileName     String?
  mediaSizeBytes    Int?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, providerMessageId])
  @@index([teamId, createdAt])
  @@index([conversationId, createdAt])
}

model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model InternalComment {
  id             String       @id @default(cuid())
  conversationId String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ConversationTag {
  conversationId String
  labelId        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label          Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
}

model ConversationEvent {
  id             String                @id @default(cuid())
  conversationId String
  actorUserId    String?
  type           ConversationEventType
  metadata       Json?
  createdAt      DateTime              @default(now())
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Chat {
  id              String          @id @default(cuid())
  teamId          String
  sessionId       String
  providerChatId  String
  name            String?
  isGroup         Boolean         @default(false)
  lastMessageAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  team            Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
