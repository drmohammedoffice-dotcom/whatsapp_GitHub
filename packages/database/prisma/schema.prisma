/// Per-workspace appointment business profile (clinic / salon / etc.).
model AppointmentBusinessProfile {
  id                   String              @id @default(cuid())
  teamId               String              @unique
  vertical             AppointmentVertical @default(CLINIC)
  orgName              String?
  description          String?
  phone                String?
  email                String?
  address              String?
  timezone             String              @default("Asia/Baghdad")
  defaultDurationMin   Int                 @default(30)
  bufferMin            Int                 @default(0)
  /// Minutes free before each appointment (in addition to bufferMin when set).
  bufferBeforeMin      Int                 @default(0)
  /// Minutes free after each appointment.
  bufferAfterMin       Int                 @default(0)
  /// Lunch / break length deducted from each working day (minutes).
  breakMin             Int                 @default(0)
  /// Soft cap on appointments per calendar day (null = unlimited).
  maxDailyAppointments Int?
  bookingWindowDays    Int                 @default(30)
  instructions         String?
  faqJson              Json?
  /// Structured clinic AI knowledge (location, policies, insurance, payments, etc.).
  clinicKnowledge      Json?
  businessHours        Json?
  /// Capability flags for AI / agents in this workspace.
  aiCanReply           Boolean             @default(true)
  aiCanCreate          Boolean             @default(true)
  aiCanUpdate          Boolean             @default(true)
  aiCanCancel          Boolean             @default(true)
  aiCanReadCalendar    Boolean             @default(true)
  aiCanSendReminders   Boolean             @default(true)
  enabled              Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  team                 Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff                AppointmentStaff[]
  services             AppointmentServiceOffer[]
}

model AppointmentStaff {
