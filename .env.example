NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watsapp?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=change-me-32-byte-minimum-session-key
API_KEY_PEPPER=change-me-api-key-pepper-at-least-32-characters
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret-at-least-32-characters
LOCAL_STORAGE_ROOT=./storage
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-openai-compatible-key
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_AUDIO_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_MONTHLY_BUDGET_CENTS=10000
AI_RATE_LIMIT_PER_MINUTE=60

# Email OTP (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ChatLoora <noreply@almutamayiziq.com>
# Set to false until Resend domain is verified
AUTH_OTP_ENABLED=true

# TikTok Business API (https://business-api.tiktok.com/portal/docs)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Login Kit callback (register this exact URL in TikTok Developer Portal)
TIKTOK_REDIRECT_URI=https://yourdomain.com/api/auth/tiktok/callback
# TikTok Marketing API (numeric App ID — separate from Login Kit client_key)
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TIKTOK_BUSINESS_REDIRECT_URI=https://yourdomain.com/api/auth/tiktok-business/callback
# Chatloora SaaS ads pixel (CompleteRegistration / Purchase after signup & payment)
TIKTOK_PLATFORM_PIXEL_CODE=
TIKTOK_PLATFORM_EVENTS_ACCESS_TOKEN=

# Meta Messenger + Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-webhook-verify-token
META_AUTH_REDIRECT_URI=https://yourdomain.com/api/auth/meta/callback
# Legacy redirect (optional): https://yourdomain.com/api/v1/meta/oauth/callback
META_OAUTH_REDIRECT_URI=

# Telegram personal account (MTProto) — create at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
