  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  commissions SalesCommission[]

  @@index([partnerId, createdAt])
  @@map("sales_referrals")
}

model SalesCommission {
  id             String                @id @default(cuid())
  partnerId      String                @map("partner_id")
  referralId     String                @map("referral_id")
  paymentId      String                @unique @map("payment_id")
  subscriptionId String                @map("subscription_id")
  teamId         String                @map("team_id")
  planId         String                @map("plan_id")
  kind           SalesCommissionKind
  status         SalesCommissionStatus @default(PENDING)
  amountCents    Int                   @map("amount_cents")
  currency       String                @default("IQD")
  saleCents      Int                   @map("sale_cents")
  note           String?
  approvedAt     DateTime?             @map("approved_at")
  paidAt         DateTime?             @map("paid_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  partner        SalesPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral       SalesReferral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payment        Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([partnerId, createdAt])
  @@map("sales_commissions")
}

model SalesPayoutRequest {
  id                 String            @id @default(cuid())
  partnerId          String            @map("partner_id")
  amountCents        Int               @map("amount_cents")
  currency           String            @default("IQD")
  accountNumber      String            @map("account_number")
  accountName        String?           @map("account_name")
  method             SalesPayoutMethod?
  feeCents           Int               @default(0) @map("fee_cents")
  netCents           Int               @default(0) @map("net_cents")
  accountImageKey    String?           @map("account_image_key")
  receiptImageKey    String?           @map("receipt_image_key")
  emailCodeHash      String?           @map("email_code_hash")
  emailCodeExpiresAt DateTime?         @map("email_code_expires_at")
  emailVerifiedAt    DateTime?         @map("email_verified_at")
  status             SalesPayoutStatus @default(AWAITING_EMAIL)
  adminNote          String?           @map("admin_note")
  paidAt             DateTime?         @map("paid_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  partner            SalesPartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@map("sales_payout_requests")
}

