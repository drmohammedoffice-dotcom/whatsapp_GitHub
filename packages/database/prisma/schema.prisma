  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([campaignId])
  @@index([clickToken])
}

enum TikTokOptimizationEvent {
  PageView
  ViewContent
  Lead
  CompleteRegistration
  Contact
  SubmitForm
  AddToCart
  InitiateCheckout
  Purchase
  CompletePayment
  Custom
}

model TikTokIntegration {
  id                       String                  @id @default(cuid())
  userId                   String                  @map("user_id")
  teamId                   String                  @map("team_id")
  name                     String?
  advertiserId             String?                 @map("advertiser_id")
  advertiserName           String?                 @map("advertiser_name")
  pixelId                  String?                 @map("pixel_id")
  pixelCode                String?                 @map("pixel_code")
  pixelName                String?                 @map("pixel_name")
  pixelStatus              String                  @default("pending") @map("pixel_status")
  pixelStatusMessage       String?                 @map("pixel_status_message")
  lastPixelStatusCheckAt   DateTime?               @map("last_pixel_status_check_at")
  activatedAt              DateTime?               @map("activated_at")
  /// Manual TikTok Events API access token (AES encrypted). Never return to frontend.
  encryptedEventsApiAccessToken String?            @map("encrypted_events_api_access_token")
  eventsApiTokenHint            String?            @map("events_api_token_hint")
  eventsApiConnected            Boolean            @default(false) @map("events_api_connected")
  eventsApiStatus               String             @default("disconnected") @map("events_api_status")
  eventsApiStatusMessage        String?            @map("events_api_status_message")
  lastEventsApiVerificationAt   DateTime?          @map("last_events_api_verification_at")
  lastEventSentAt               DateTime?          @map("last_event_sent_at")
  lastEventName                 String?            @map("last_event_name")
  lastApiHttpStatus             Int?               @map("last_api_http_status")
  lastApiError                  String?            @map("last_api_error")
  whatsappNumber           String?                 @map("whatsapp_number")
  redirectDestinationType  String                  @default("WHATSAPP_NUMBER") @map("redirect_destination_type")
  externalRedirectUrl      String?                 @map("external_redirect_url")
  redirectSlug             String                  @unique @map("redirect_slug")
  defaultOptimizationEvent TikTokOptimizationEvent @default(Contact) @map("default_optimization_event")
  customEventName          String?                 @map("custom_event_name")
  redirectMessage          String?                 @map("redirect_message")
  wizardStep               Int                     @default(1) @map("wizard_step")
  wizardCompleted          Boolean                 @default(false) @map("wizard_completed")
  billingSuspended         Boolean                 @default(false) @map("billing_suspended")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                     Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventConfigurations      TikTokEventConfiguration[]
  clicks                   TikTokIntegrationClick[]
  leads                    TikTokIntegrationLead[]
  conversions              TikTokIntegrationConversion[]
  apiLogs                  TikTokIntegrationApiLog[]

  @@index([userId, teamId])
  @@index([teamId])
  @@map("tiktok_integrations")
}

model TikTokEventConfiguration {
  id            String                  @id @default(cuid())
  integrationId String                  @map("integration_id")
  eventName     TikTokOptimizationEvent @map("event_name")
  enabled       Boolean                 @default(false)
  createdAt     DateTime                @default(now()) @map("created_at")
  integration   TikTokIntegration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventName])
  @@map("tiktok_event_configurations")
}

model TikTokIntegrationClick {
  id                    String               @id @default(cuid())
  integrationId         String               @map("integration_id")
  ttclid                String?
  campaignId            String?              @map("campaign_id")
  adgroupId             String?              @map("adgroup_id")
  adId                  String?              @map("ad_id")
  advertiserId          String?              @map("advertiser_id")
  ipAddress             String?              @map("ip_address")
  userAgent             String?              @map("user_agent")
  pageViewSent          Boolean              @default(false) @map("page_view_sent")
  optimizationEventSent Boolean              @default(false) @map("optimization_event_sent")
  eventsPayload         Json?                @map("events_payload")
  createdAt             DateTime             @default(now()) @map("created_at")
  integration           TikTokIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  lead                  TikTokIntegrationLead?

  @@index([integrationId, createdAt])
  @@index([campaignId])
  @@map("tiktok_integration_clicks")
}

model TikTokIntegrationLead {
  id                String               @id @default(cuid())
  integrationId     String               @map("integration_id")
  clickId           String               @unique @map("click_id")
  conversationId    String?              @unique @map("conversation_id")
  contactId         String?              @map("contact_id")
  customerPhone     String?              @map("customer_phone")
  convertedAt       DateTime?            @map("converted_at")
  conversionEventId String?              @unique @map("conversion_event_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  integration       TikTokIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  click             TikTokIntegrationClick @relation(fields: [clickId], references: [id], onDelete: Cascade)
  conversions       TikTokIntegrationConversion[]

  @@index([integrationId, createdAt])
  @@index([integrationId, convertedAt])
  @@map("tiktok_integration_leads")
}

model TikTokIntegrationConversion {
  id              String               @id @default(cuid())
  integrationId   String               @map("integration_id")
  leadId          String?              @map("lead_id")
  clickId         String?              @map("click_id")
  conversationId  String?              @map("conversation_id")
  messageId       String?              @map("message_id")
  contactId       String?              @map("contact_id")
  whatsappPhone   String?              @map("whatsapp_phone")
  eventId         String               @unique @map("event_id")
  eventName       String               @map("event_name")
  ttclid          String?
  externalId      String?              @map("external_id")
  pageUrl         String?              @map("page_url")
  orderId         String?              @map("order_id")
  valueAmount     Float?               @map("value_amount")
  currency        String?              @map("currency")
  firstMessageAt  DateTime?            @map("first_message_at")
  contactSent     Boolean              @default(false) @map("contact_sent")
  tiktokStatus    String               @default("pending") @map("tiktok_status")
  tiktokResponse  Json?                @map("tiktok_response")
  tiktokError     String?              @map("tiktok_error")
  retryCount      Int                  @default(0) @map("retry_count")
  nextRetryAt     DateTime?            @map("next_retry_at")
  sentAt          DateTime?            @map("sent_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  integration     TikTokIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  lead            TikTokIntegrationLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  apiLogs         TikTokIntegrationApiLog[]

  // One Contact per conversation; messageId keeps webhook retries idempotent.
  @@unique([integrationId, eventName, conversationId])
  @@unique([integrationId, eventName, messageId])
  @@unique([integrationId, eventName, orderId])
  @@index([integrationId, conversationId, createdAt])
  @@index([integrationId, whatsappPhone, sentAt])
  @@index([integrationId, eventName, sentAt])
  @@index([tiktokStatus, nextRetryAt])
  @@map("tiktok_integration_conversions")
}

model TikTokIntegrationInboundDiag {
  id                 String   @id @default(cuid())
  teamId             String   @map("team_id")
  integrationId      String?  @map("integration_id")
  channelId          String?  @map("channel_id")
  conversationId     String?  @map("conversation_id")
  messageId          String?  @map("message_id")
  whatsappPhone      String?  @map("whatsapp_phone")
  businessPhone      String?  @map("business_phone")
  pixelCode          String?  @map("pixel_code")
  ttclid             String?  @map("ttclid")
  isNewConversation  Boolean? @map("is_new_conversation")
  outcome            String
  reason             String?
  tiktokStatus       String?  @map("tiktok_status")
  tiktokResponse     Json?    @map("tiktok_response")
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([teamId, createdAt])
  @@index([integrationId, createdAt])
  @@map("tiktok_integration_inbound_diags")
}

model TikTokIntegrationApiLog {
  id              String   @id @default(cuid())
  integrationId   String?  @map("integration_id")
  conversionId    String?  @map("conversion_id")
  eventName       String   @map("event_name")
  eventId         String?  @map("event_id")
  attempt         Int      @default(1)
  httpStatus      Int?     @map("http_status")
  success         Boolean  @default(false)
  processingMs    Int?     @map("processing_ms")
  requestPayload  Json?    @map("request_payload")
  responseBody    Json?    @map("response_body")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  integration     TikTokIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  conversion      TikTokIntegrationConversion? @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@index([integrationId, createdAt])
  @@index([conversionId, attempt])
  @@map("tiktok_integration_api_logs")
}

